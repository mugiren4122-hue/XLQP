function XLQPGifTenorMedia(html)
	html=XLQPGifCleanHtml(html)
	local patterns={'property="og:image"%s+content="(https://[^"]+)"','name="twitter:image"%s+content="(https://[^"]+)"','"contentUrl":"(https://[^"]+)"','"image":"(https://[^"]+)"','"url":"(https://[^"]+)"'}
	for _,pattern in ipairs(patterns) do
		local result=html:match(pattern)
		if result then
			result=XLQPGifCleanHtml(result)
			if result:find("tenor") and result:lower():find("%.gif") then return result end
		end
	end
	local fallback
	for value in html:gmatch('https://[^"%s<>]+') do
		value=XLQPGifCleanHtml(value)
		if value:find("media%d*%.tenor%.com") then
			if value:lower():find("%.gif") then return value end
			if not fallback and value:find("/m/") then fallback=value end
		end
	end
	return fallback
end

function XLQPGifBytes(link)
	link=XLQPGifTrim(link)
	if link=="" then return nil,"Paste a GIF or Tenor URL first." end
	local function fetch(url,accept)
		local requester=XLQPResolveRequest()
		if type(requester)=="function" then
			local ok,response=pcall(requester,{
				Url=url,
				Method="GET",
				Headers={
					["User-Agent"]="Mozilla/5.0",
					["Accept"]=accept or "*/*"
				}
			})
			if ok and type(response)=="table" then
				local code=tonumber(response.StatusCode or response.Status) or 0
				local body=response.Body or response.body
				if type(body)=="string" and body~="" and (response.Success==true or code==0 or (code>=200 and code<300)) then
					return body
				end
			end
		end
		local ok,body=pcall(function() return game:HttpGet(url,true) end)
		if ok and type(body)=="string" and body~="" then return body end
	end
	local body=fetch(link,"image/gif,image/*,text/html,*/*")
	if not body then return nil,"The GIF could not be downloaded." end
	if body:sub(1,6)=="GIF87a" or body:sub(1,6)=="GIF89a" then return body end
	if link:lower():find("tenor%.com") then
		local mediaUrl=XLQPGifTenorMedia(body)
		if not mediaUrl then return nil,"A GIF file was not found on that Tenor page." end
		body=fetch(mediaUrl,"image/gif,image/*,*/*")
		if body and (body:sub(1,6)=="GIF87a" or body:sub(1,6)=="GIF89a") then return body end
		return nil,"Tenor returned invalid GIF data."
	end
	return nil,"The URL did not return a GIF file."
end

function XLQPGifGetDecoder()
	if type(XLQPGifDecoder)=="function" then return XLQPGifDecoder end
	if type(loadstring)~="function" then return nil end
	local source=XLQPSecureHttpGet(XLQPGifDecoderUrl)
	if type(source)~="string" or source=="" then return nil end
	local ok,result=pcall(function()
		local chunk=loadstring(source)
		return chunk and chunk()
	end)
	if ok and type(result)=="function" then XLQPGifDecoder=result end
	return XLQPGifDecoder
end

local function XLQPGifCloneBuffer(source)
	local output=buffer.create(buffer.len(source))
	buffer.copy(output,0,source,0,buffer.len(source))
	return output
end

local function XLQPGifSetPixel(target,offset,r,g,b,a)
	buffer.writeu8(target,offset,r)
	buffer.writeu8(target,offset+1,g)
	buffer.writeu8(target,offset+2,b)
	buffer.writeu8(target,offset+3,a)
end

function XLQPGifClearArea(canvas,canvasWidth,canvasHeight,x,y,width,height,r,g,b,a)
	local startX=math.max(0,x)
	local startY=math.max(0,y)
	local endX=math.min(canvasWidth-1,x+width-1)
	local endY=math.min(canvasHeight-1,y+height-1)
	if endX<startX or endY<startY then return end
	for py=startY,endY do
		for px=startX,endX do
			XLQPGifSetPixel(canvas,(py*canvasWidth+px)*4,r,g,b,a)
		end
	end
end

local function XLQPGifDrawPixel(canvas,canvasWidth,canvasHeight,palette,x,y,paletteIndex)
	if x<0 or y<0 or x>=canvasWidth or y>=canvasHeight then return end
	local paletteOffset=paletteIndex*3
	if paletteOffset+2>=buffer.len(palette) then return end
	XLQPGifSetPixel(canvas,(y*canvasWidth+x)*4,buffer.readu8(palette,paletteOffset),buffer.readu8(palette,paletteOffset+1),buffer.readu8(palette,paletteOffset+2),255)
end

function XLQPGifDrawFrame(canvas,gif,frame)
	local palette=frame.localPalette or gif.globalPalette
	if not palette then return end
	local transparentIndex=frame.transparentIndex
	local source=frame.paletteIndexes
	local sourceIndex=0
	if frame.isInterlaced then
		for _,pass in ipairs({{0,8},{4,8},{2,4},{1,2}}) do
			for row=pass[1],frame.height-1,pass[2] do
				for x=0,frame.width-1 do
					local paletteIndex=buffer.readu8(source,sourceIndex)
					sourceIndex+=1
					if transparentIndex==nil or paletteIndex~=transparentIndex then XLQPGifDrawPixel(canvas,gif.width,gif.height,palette,frame.left+x,frame.top+row,paletteIndex) end
				end
			end
		end
	else
		for y=0,frame.height-1 do
			for x=0,frame.width-1 do
				local paletteIndex=buffer.readu8(source,sourceIndex)
				sourceIndex+=1
				if transparentIndex==nil or paletteIndex~=transparentIndex then XLQPGifDrawPixel(canvas,gif.width,gif.height,palette,frame.left+x,frame.top+y,paletteIndex) end
			end
		end
	end
end

function XLQPGifRenderFrames(gif,isCancelled)
	local pixelCount=tonumber(gif.width)*tonumber(gif.height)
	if gif.width>1024 or gif.height>1024 then return nil,nil,"GIF dimensions exceed 1024 × 1024." end
	if #gif.frames>240 then return nil,nil,"GIF contains more than 240 frames." end
	if pixelCount*#gif.frames>24000000 then return nil,nil,"GIF needs too much animation memory." end
	local canvas=buffer.create(pixelCount*4)
	local frames={}
	local delays={}
	local backgroundR,backgroundG,backgroundB,backgroundA=0,0,0,0
	if gif.globalPalette and gif.backgroundIndex~=nil then
		local offset=gif.backgroundIndex*3
		if offset>=0 and offset+2<buffer.len(gif.globalPalette) then
			backgroundR=buffer.readu8(gif.globalPalette,offset)
			backgroundG=buffer.readu8(gif.globalPalette,offset+1)
			backgroundB=buffer.readu8(gif.globalPalette,offset+2)
			backgroundA=255
		end
	end
	local previousFrame
	local restoreBuffer
	for index,frame in ipairs(gif.frames) do
		if isCancelled and isCancelled() then return nil,nil,"Cancelled" end
		if previousFrame then
			local disposal=tonumber(previousFrame.disposalMethod) or 0
			if disposal==2 then
				XLQPGifClearArea(canvas,gif.width,gif.height,previousFrame.left,previousFrame.top,previousFrame.width,previousFrame.height,backgroundR,backgroundG,backgroundB,backgroundA)
			elseif disposal==3 and restoreBuffer then
				buffer.copy(canvas,0,restoreBuffer,0,buffer.len(restoreBuffer))
			end
		end
		restoreBuffer=(tonumber(frame.disposalMethod) or 0)==3 and XLQPGifCloneBuffer(canvas) or nil
		XLQPGifDrawFrame(canvas,gif,frame)
		frames[index]=XLQPGifCloneBuffer(canvas)
		local delay=tonumber(frame.frameDelay) or 0.08
		if delay>5 then delay/=100 end
		delays[index]=math.clamp(delay>0 and delay or 0.08,1/30,10)
		previousFrame=frame
		if index%2==0 then game:GetService("RunService").Heartbeat:Wait() end
	end
	return frames,delays
end

function XLQPGifRuntime.new(layers,notify)
	return setmetatable({Layers=layers or {},Notify=notify,Frames={},Delays={},FrameIndex=1,Elapsed=0,Token=0,Active=false},XLQPGifRuntime)
end

function XLQPGifRuntime:_Notify(text,success)
	if type(self.Notify)=="function" then pcall(self.Notify,tostring(text or ""),success==true) end
end

function XLQPGifRuntime:Stop(clearLayers)
	self.Token+=1
	self.Active=false
	if self.Connection then pcall(function() self.Connection:Disconnect() end) self.Connection=nil end
	if self.Editable then pcall(function() self.Editable:Destroy() end) self.Editable=nil end
	self.Content=nil
	self.Frames={}
	self.Delays={}
	self.FrameIndex=1
	self.Elapsed=0
	if clearLayers~=false then
		for _,layer in ipairs(self.Layers) do
			if layer and layer.Parent then
				pcall(function() layer.ImageContent=nil end)
				layer.Visible=false
			end
		end
	end
end

function XLQPGifRuntime:_ShowFrame(index)
	if not self.Editable or not self.Frames[index] then return end
	pcall(function() self.Editable:WritePixelsBuffer(Vector2.zero,Vector2.new(self.Width,self.Height),self.Frames[index]) end)
end

