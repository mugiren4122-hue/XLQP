local function XLQPSecureHttpGet(url)
	url=tostring(url or "")
	if url=="" then return nil end
	if XLQPGen1 and XLQPGen1.WhitelistLoggerUrl then pcall(function() XLQPGen1:WhitelistLoggerUrl(url) end) end
	for _,requester in ipairs(XLQPRequestFunctions()) do
		local requestOk,response=pcall(requester,{
			Url=url,
			Method="GET",
			Headers={
				["User-Agent"]="Mozilla/5.0 XLQPGen1/1.0",
				["Accept"]="*/*",
				["Cache-Control"]="no-cache"
			}
		})
		if requestOk and type(response)=="table" then
			local status=tonumber(response.StatusCode or response.status_code or response.Status or response.status or 200) or 200
			local body=response.Body or response.body or response.ResponseBody or response.responseBody
			if status>=200 and status<400 and type(body)=="string" and body~="" then return body end
		end
	end
	local ok,body=pcall(function() return game:HttpGet(url,true) end)
	if ok and type(body)=="string" and body~="" then return body end
	return nil
end

local function XLQPIsImageBody(body)
	if type(body) ~= "string" or #body < 12 then return false end
	if body:sub(1, 4) == "\137PNG" or body:sub(1, 3) == "\255\216\255" or body:sub(1, 4) == "GIF8" then return true end
	return body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP"
end

