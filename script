local function XLQPThumbnailRequest(value, allowAvatar)
	local id = XLQPAssetId(value)
	if id then
		if not XLQPSecureBuiltins[id] then return nil end
		return "https://assetdelivery.roblox.com/v1/asset/?id=" .. id, "asset_" .. id, true
	end
	if not allowAvatar or type(value) ~= "string" then return nil end
	local thumbType, thumbId = value:match("^rbxthumb://type=([^&]+)&id=(%d+)")
	if not thumbId then return nil end
	if thumbType == "AvatarHeadShot" then
		return "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. thumbId .. "&size=420x420&format=Png&isCircular=false", "avatar_" .. thumbId
	elseif thumbType == "Avatar" then
		return "https://thumbnails.roblox.com/v1/users/avatar?userIds=" .. thumbId .. "&size=420x420&format=Png&isCircular=false", "avatar_body_" .. thumbId
	elseif thumbType == "GameIcon" then
		return "https://thumbnails.roblox.com/v1/places/gameicons?placeIds=" .. thumbId .. "&returnPolicy=PlaceHolder&size=512x512&format=Png&isCircular=false", "place_" .. thumbId
	end
	return nil
end

local function XLQPResolveSecureAsset(value, allowAvatar, callback)
	if not XLQPSecureMode then
		if callback then callback(value) end
		return value
	end
	if type(value) ~= "string" or value == "" then return value end
	if value:match("^rbxasset://") or value:match("^content://") or value:match("^synasset://") then
		if callback then callback(value) end
		return value
	end
	local trustedId=XLQPAssetId(value)
	if trustedId and XLQPSecureBuiltins[trustedId] then
		local nativeAsset="rbxassetid://"..trustedId
		XLQPSecureResolved["asset_"..trustedId]=nativeAsset
		if callback then callback(nativeAsset) end
		return nativeAsset
	end
	if allowAvatar and value:match("^rbxthumb://") then
		if callback then callback(value) end
		return value
	end
	local endpoint, cacheKey, directAsset = XLQPThumbnailRequest(value, allowAvatar)
	if not endpoint then return "" end
	if XLQPSecureResolved[cacheKey] then
		if callback then callback(XLQPSecureResolved[cacheKey]) end
		return XLQPSecureResolved[cacheKey]
	end
	if not XLQPPrepareSecureFolder() then
		XLQPSecureFailures += 1
		return ""
	end
	local path = XLQPSecureCacheFolder .. "/" .. cacheKey .. ".png"
	if isfile(path) then
		local ok, asset = pcall(XLQPGetCustomAsset, path)
		if ok and asset then
			XLQPSecureResolved[cacheKey] = asset
			if callback then callback(asset) end
			return asset
		end
	end
	XLQPSecurePending[cacheKey] = XLQPSecurePending[cacheKey] or {}
	if callback then table.insert(XLQPSecurePending[cacheKey], callback) end
	if #XLQPSecurePending[cacheKey] == (callback and 1 or 0) then
		task.spawn(function()
			local metadata
			if not directAsset then metadata = XLQPSecureHttpGet(endpoint) end
			local imageUrl
			if metadata then
				pcall(function()
					local decoded = game:GetService("HttpService"):JSONDecode(metadata)
					imageUrl = decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl
				end)
			end
			local imageBody = directAsset and XLQPSecureHttpGet(endpoint) or (imageUrl and XLQPSecureHttpGet(imageUrl))
			if directAsset and not XLQPIsImageBody(imageBody) then
				imageBody = XLQPSecureThumbnailBody(cacheKey:match("^asset_(%d+)$"))
			end
			local asset
			if XLQPIsImageBody(imageBody) and pcall(writefile, path, imageBody) then
				local ok
				ok, asset = pcall(XLQPGetCustomAsset, path)
				if not ok then asset = nil end
			end
			if asset then XLQPSecureResolved[cacheKey] = asset else XLQPSecureFailures += 1 end
			local callbacks = XLQPSecurePending[cacheKey] or {}
			XLQPSecurePending[cacheKey] = nil
			for _, pendingCallback in ipairs(callbacks) do
				if asset then pcall(pendingCallback, asset) end
			end
		end)
	end
	return ""
end

local function XLQPSetSecureAsset(object, property, value, allowAvatar)
	value = XLQPTranslateAsset(value)
	if not XLQPSecureMode then
		object[property] = value
		return value
	end
	local resolved = XLQPResolveSecureAsset(value, allowAvatar, function(asset)
		if object and object.Parent then pcall(function() object[property] = asset end) end
	end)
	object[property] = resolved
	return resolved
end

local XLQPSecureImageProperties = {
	Image = true, HoverImage = true, PressedImage = true,
	MidImage = true, TopImage = true, BottomImage = true, Texture = true
}
local XLQPSecureBlockedProperties = {
	SoundId = true, Video = true, MeshId = true, TextureID = true, TextureId = true
}

local function XLQPAssignProperty(object, property, value)
	if XLQPSecureImageProperties[property] and typeof(value)=="Instance" then
		local assigned=pcall(function() object.ImageContent=Content.fromObject(value) end)
		if not assigned then pcall(function() object[property]="" end) end
		return value
	end
	if XLQPSecureImageProperties[property] then value = XLQPTranslateAsset(value) end
	if XLQPSecureMode and XLQPSecureImageProperties[property] then
		local allowAvatar = type(value) == "string" and value:match("^rbxthumb://") ~= nil
		return XLQPSetSecureAsset(object, property, value, allowAvatar)
	end
	if XLQPSecureMode and XLQPSecureBlockedProperties[property] and type(value) == "string" then
		if XLQPAssetId(value) or value:match("^rbxthumb://") or value:match("^https?://") then
			object[property] = ""
			return ""
		end
	end
	object[property] = value
	return value
end

local XLQPSecureImageGuardProps = {"Image", "HoverImage", "PressedImage"}
local XLQPSecureScrollGuardProps = {"MidImage", "TopImage", "BottomImage"}
XLQPSecureVideoGuardProps = {"Video"}
XLQPSecureSoundGuardProps = {"SoundId"}
local function XLQPGuardSecureAssetObject(object)
	if not XLQPSecureMode or typeof(object) ~= "Instance" then return end
	local properties
	if object:IsA("ImageLabel") or object:IsA("ImageButton") then
		properties = XLQPSecureImageGuardProps
	elseif object:IsA("ScrollingFrame") then
		properties = XLQPSecureScrollGuardProps
	elseif object:IsA("VideoFrame") then
		properties = XLQPSecureVideoGuardProps
	elseif object:IsA("Sound") then
		properties = XLQPSecureSoundGuardProps
	else
		return
	end
	local changing = {}
	for _, property in ipairs(properties) do
		local ok, signal = pcall(function() return object:GetPropertyChangedSignal(property) end)
		if ok and signal then
			signal:Connect(function()
				if changing[property] then return end
				local readOk, value = pcall(function() return object[property] end)
				if not readOk or type(value) ~= "string" or value == "" then return end
				if value:match("^rbxasset://") or value:match("^content://") or value:match("^synasset://") then return end
				if XLQPSecureImageProperties[property] or XLQPSecureBlockedProperties[property] then
					changing[property] = true
					XLQPAssignProperty(object, property, value)
					changing[property] = nil
				end
			end)
		end
	end
end

local function XLQPProtectGuiAssets(root)
	if not XLQPSecureMode or typeof(root) ~= "Instance" then return end
	XLQPGuardSecureAssetObject(root)
	for _, descendant in ipairs(root:GetDescendants()) do XLQPGuardSecureAssetObject(descendant) end
	root.DescendantAdded:Connect(XLQPGuardSecureAssetObject)
end

