function XLQPAttachCursorGlow(frame,hitbox,config)
	if typeof(frame)~="Instance" or frame:GetAttribute("XLQPCursorGlow")==true then return nil end
	config=type(config)=="table" and config or {}
	if config.CursorGlow==false or config.Glow==false then return nil end
	frame:SetAttribute("XLQPCursorGlow",true)
	hitbox=typeof(hitbox)=="Instance" and hitbox or frame
	local size=math.clamp(math.floor(tonumber(config.CursorGlowSize) or 120),24,600)
	local glow=Create("Frame",{
		Name="XLQPCursorGlow",
		AnchorPoint=Vector2.new(0.5,0.5),
		Size=UDim2.fromOffset(size,size),
		Position=UDim2.fromScale(0.5,0.5),
		BackgroundColor3=XLQPResolveTagColor(config.CursorGlowColor,Color3.fromRGB(255,255,255)),
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ZIndex=(tonumber(frame.ZIndex) or 1)+1,
		Visible=false,
		Parent=frame
	})
	glow:SetAttribute("NoLiquidGlass",true)
	Create("UICorner",{CornerRadius=UDim.new(1,0),Parent=glow})
	Create("UIGradient",{
		Rotation=0,
		Transparency=NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.35),
			NumberSequenceKeypoint.new(0.45,0.72),
			NumberSequenceKeypoint.new(1,1)
		}),
		Parent=glow
	})
	local peak=math.clamp(tonumber(config.CursorGlowStrength) or 0.72,0,1)
	local active=false
	local function place(x,y)
		local origin=frame.AbsolutePosition
		glow.Position=UDim2.fromOffset(x-origin.X,y-origin.Y)
	end
	AddConnection(hitbox.MouseEnter,function()
		if frame:GetAttribute("XLQPLockedOut")==true then return end
		active=true
		glow.Visible=true
		TweenService:Create(glow,TweenInfo.new(0.18,Enum.EasingStyle.Quad),{BackgroundTransparency=peak}):Play()
	end)
	AddConnection(hitbox.MouseLeave,function()
		active=false
		TweenService:Create(glow,TweenInfo.new(0.24,Enum.EasingStyle.Quad),{BackgroundTransparency=1}):Play()
		task.delay(0.26,function() if not active and glow.Parent then glow.Visible=false end end)
	end)
	AddConnection(hitbox.MouseMoved,function(x,y)
		if not active then return end
		place(x,y)
	end)
	AddConnection(hitbox.InputChanged,function(input)
		if not active then return end
		if input.UserInputType==Enum.UserInputType.Touch then place(input.Position.X,input.Position.Y) end
	end)
	return glow
end

function XLQPApplyElementStyle(frame,config,object)
	if typeof(frame)~="Instance" or type(config)~="table" then return frame end
	local style=type(config.Style)=="table" and config.Style or config
	local function pick(...)
		for index=1,select("#",...) do
			local value=select(index,...)
			if value~=nil then return value end
		end
		return nil
	end
	local background=pick(style.BackgroundColor,style.BackgroundColor3,config.BackgroundColor)
	if background~=nil then
		local resolved=XLQPResolveTagColor(background,nil)
		if resolved then
			frame.BackgroundColor3=resolved
			frame:SetAttribute("XLQPStyleLocked",true)
		end
	end
	local transparency=pick(style.BackgroundTransparency,config.BackgroundTransparency)
	if tonumber(transparency) then frame.BackgroundTransparency=math.clamp(tonumber(transparency),0,1) end
	local radius=pick(style.CornerRadius,config.CornerRadius)
	if tonumber(radius) then
		local corner=frame:FindFirstChildOfClass("UICorner")
		if not corner then corner=Create("UICorner",{Parent=frame}) end
		corner.CornerRadius=UDim.new(0,math.max(0,math.floor(tonumber(radius))))
	end
	local height=pick(config.WrapperHeight,config.ElementHeight)
	if type(config.Style)=="table" then height=pick(config.Style.Height,height) end
	if tonumber(height) and frame.Size.Y.Scale==0 then
		frame.Size=UDim2.new(frame.Size.X.Scale,frame.Size.X.Offset,0,math.max(1,math.floor(tonumber(height))))
	end
	local stroke=frame:FindFirstChildOfClass("UIStroke")
	local strokeColor=pick(style.StrokeColor,config.StrokeColor,style.OutlineColor)
	local strokeTransparency=pick(style.StrokeTransparency,config.StrokeTransparency)
	local strokeThickness=pick(style.StrokeThickness,config.StrokeThickness)
	if (strokeColor~=nil or strokeTransparency~=nil or strokeThickness~=nil) then
		if not stroke then stroke=Create("UIStroke",{Parent=frame}) end
		if strokeColor~=nil then
			local resolved=XLQPResolveTagColor(strokeColor,nil)
			if resolved then stroke.Color=resolved stroke:SetAttribute("XLQPStyleLocked",true) end
		end
		if tonumber(strokeTransparency) then stroke.Transparency=math.clamp(tonumber(strokeTransparency),0,1) end
		if tonumber(strokeThickness) then stroke.Thickness=math.max(0,tonumber(strokeThickness)) end
	end
	local titleColor=pick(style.TitleColor,config.TitleColor,style.TextColor3)
	local descriptionColor=pick(style.DescriptionColor,config.DescriptionColor)
	local titleSize=pick(style.TitleSize,config.TitleSize)
	local fontValue=pick(style.Font,config.Font)
	local resolvedFont
	if fontValue~=nil then
		if typeof(fontValue)=="EnumItem" then
			resolvedFont=fontValue
		else
			local ok,found=pcall(function() return Enum.Font[tostring(fontValue):gsub("%s+","")] end)
			if ok then resolvedFont=found end
		end
	end
	for _,child in ipairs(frame:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
			local isTitle=child.Name=="Content" or child.Name=="Title" or child.Name=="EntryTitle"
			local isDescription=child.Name=="Description" or child.Name=="Desc" or child.Name=="EntryDescription"
			if titleColor~=nil and isTitle then
				local resolved=XLQPResolveTagColor(titleColor,nil)
				if resolved then child.TextColor3=resolved child:SetAttribute("XLQPTextColorOverride",resolved) end
			end
			if descriptionColor~=nil and isDescription then
				local resolved=XLQPResolveTagColor(descriptionColor,nil)
				if resolved then child.TextColor3=resolved child:SetAttribute("XLQPTextColorOverride",resolved) end
			end
			if tonumber(titleSize) and isTitle then child.TextSize=math.clamp(tonumber(titleSize),6,48) end
			if resolvedFont then child.Font=resolvedFont end
		end
	end
	if type(object)=="table" then
		function object:SetStyle(newStyle)
			if type(newStyle)~="table" then return self end
			XLQPApplyElementStyle(frame,{Style=newStyle},nil)
			return self
		end
	end
	return frame
end


