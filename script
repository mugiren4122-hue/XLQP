local function XLQPAssetId(value)
	if type(value) == "number" then return tostring(value) end
	if type(value) ~= "string" then return nil end
	return value:match("^rbxassetid://(%d+)$")
		or value:match("^https?://www%.roblox%.com/asset/%?id=(%d+)")
		or value:match("^https?://www%.roblox%.com/library/(%d+)")
		or value:match("^https?://create%.roblox%.com/store/asset/(%d+)")
		or value:match("^https?://assetdelivery%.roblox%.com/.-[?&]id=(%d+)")
		or value:match("^(%d+)$")
end

local function XLQPRegisterSecureBuiltin(value)
	local id = XLQPAssetId(value)
