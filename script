function XLQPResolveThemeName(name)
	local raw=tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
	if raw=="" then return nil end
	if XLQPGen1.Themes[raw] then return raw end
	local lower=raw:lower()
	local aliases={
		["dark"]="Default",
		["default"]="Default",
		["deep indigo"]="Indigo",
		["cool gray teal"]="Graphite",
		["warm and soft"]="Warm",
		["cool blue-gray"]="Slate",
		["deep navy blue"]="Ocean",
		["arctic frost"]="Nord",
		["deep forest"]="Forest",
		["royal purple"]="Amethyst",
		["soft plum pink"]="Rose",
		["warm vintage"]="Retro",
		["frosted glass"]="Glass",
		["crisp and clean"]="Porcelain"
	}
	local alias=aliases[lower]
	if alias then
		if not XLQPGen1.Themes[alias] then XLQPRegisterNativeThemes() end
		if XLQPGen1.Themes[alias] then return alias end
	end
	for _,themeCard in ipairs(XLQPNativeThemeCards or {}) do
		if tostring(themeCard.Name):lower()==lower or tostring(themeCard.Description or ""):lower()==lower then
			if not XLQPGen1.Themes[themeCard.Name] then XLQPRegisterNativeThemes() end
			return XLQPGen1.Themes[themeCard.Name] and themeCard.Name or nil
		end
	end
	for themeName,themeData in pairs(XLQPGen1.Themes or {}) do
		if tostring(themeName):lower()==lower then return themeName end
		if type(themeData)=="table" and tostring(themeData.Description or ""):lower()==lower then return themeName end
	end
	return nil
end

XLQPGen1._NeonStrokes = setmetatable({}, {__mode = "k"})
XLQPGen1._NeonStrokeCount = 0

function XLQPRegisterNeonStroke(stroke, active)
	if typeof(stroke) ~= "Instance" then return end
	local registry = XLQPGen1._NeonStrokes
	local had = registry[stroke] ~= nil
	if active then
		if not had then XLQPGen1._NeonStrokeCount = XLQPGen1._NeonStrokeCount + 1 end
		registry[stroke] = true
	else
		if had then XLQPGen1._NeonStrokeCount = math.max(0, XLQPGen1._NeonStrokeCount - 1) end
		registry[stroke] = nil
	end
	if XLQPGen1._NeonStrokeCount > 0 and not XLQPGen1._NeonDriver then
		local elapsed=0
		XLQPGen1._NeonDriver = RunService.Heartbeat:Connect(function(deltaTime)
			if XLQPGen1._NeonStrokeCount <= 0 then
				if XLQPGen1._NeonDriver then XLQPGen1._NeonDriver:Disconnect() XLQPGen1._NeonDriver = nil end
				return
			end
			if XLQPGen1._ReduceLagEnabled then return end
			elapsed=elapsed+(tonumber(deltaTime) or 0)
			if elapsed<1/15 then return end
			elapsed=0
			local color = Color3.fromHSV((tick() * 0.2) % 1, 1, 1)
			for target in pairs(XLQPGen1._NeonStrokes) do
				if target.Parent then target.Color = color end
			end
		end)
	end
end

function XLQPGen1:IsUnlockedFor(lock)
	if lock==nil or lock==false then return true end
	local player=Players and Players.LocalPlayer
	if not player then return true end
	local list={}
	if type(lock)=="table" then
		for _,value in pairs(lock) do list[#list+1]=value end
	else
		list[1]=lock
	end
	if #list==0 then return true end
	local userId=tonumber(player.UserId) or -1
	local name=tostring(player.Name or ""):lower()
	local display=tostring(player.DisplayName or ""):lower()
	for _,value in ipairs(list) do
		local numeric=tonumber(value)
		if numeric and math.floor(numeric)==userId then return true end
		if type(value)=="string" then
			local text=value:lower():gsub("^@",""):gsub("^%s+",""):gsub("%s+$","")
			if text~="" and (text==name or text==display) then return true end
		end
	end
	return false
end

function XLQPGen1:_ExtractLock(config)
	if type(config)~="table" then return nil end
	local lock=config.LockedTo
	if lock==nil then lock=config.lockedto end
	if lock==nil then lock=config.LockTo end
	if lock==nil then lock=config.AllowedUsers end
	if lock==nil then lock=config.OnlyFor end
	return lock
end

function XLQPGen1:_ResolveLock(config)
	return self:IsUnlockedFor(self:_ExtractLock(config))
end

