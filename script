local function XLQPHarvestAssetModel(root)
	local icons = {}
	local function visit(instance)
		local value
		if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			value = instance.Image
		elseif instance:IsA("Decal") or instance:IsA("Texture") then
			value = instance.Texture
		elseif instance:IsA("StringValue") then
			value = instance.Value
		end
		if type(value) == "string" and value ~= "" then
			icons[instance.Name] = value
			XLQPRegisterSecureBuiltin(value)
		end
	end
	pcall(visit, root)
	for _, descendant in ipairs(root:GetDescendants()) do pcall(visit, descendant) end
	return icons
end

local function XLQPGetAssetModel()
	if XLQPAssetModelLoaded then return XLQPAssetModel, XLQPAssetModelIcons end
	XLQPAssetModelLoaded = true
	if not XLQPAssetModelId then return nil, nil end
	local fetchOk, objects = pcall(function() return game:GetObjects("rbxassetid://" .. XLQPAssetModelId) end)
	if not fetchOk or type(objects) ~= "table" or typeof(objects[1]) ~= "Instance" then
		XLQPAssetModelIcons = {}
		XLQPAssetModelError = "Invalid model asset " .. XLQPAssetModelId .. ". It could not be loaded, so it is private, deleted, not a model, or the wrong ID. Wrong model asset, please fix it."
		return nil, XLQPAssetModelIcons
	end
	XLQPAssetModel = objects[1]
	local harvestOk, icons = pcall(XLQPHarvestAssetModel, XLQPAssetModel)
	XLQPAssetModelIcons = (harvestOk and type(icons) == "table") and icons or {}
	if next(XLQPAssetModelIcons) == nil then
		XLQPAssetModelError = "Model asset " .. XLQPAssetModelId .. " loaded but holds no images. Wrong model asset, please fix it."
	end
	return XLQPAssetModel, XLQPAssetModelIcons
end

